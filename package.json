{
  "name": "learning-road",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal roadmap, study planner and job-search tracker",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate-cli.ts",
    "db:seed": "tsx src/server/db/seed-cli.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "cookie-parser": "^1.4.7",
    "dompurify": "^3.5.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "marked": "^18.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.21.0",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.23",
    "vue-router": "^4.6.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.65.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.4",
    "supertest": "^7.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.3.14"
  }
}
