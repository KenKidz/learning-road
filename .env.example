# Server
PORT=3000
NODE_ENV=development

# PGlite data directory (embedded PostgreSQL, persisted on disk)
DATABASE_DIR=./data/pg

# Optional single-user password protection.
# Leave empty to run locally without a login. Set it when exposing the app on a network.
APP_PASSWORD=

# Secret used to sign the session cookie. Required only when APP_PASSWORD is set.
# Use a long random value, e.g. `openssl rand -hex 32`.
SESSION_SECRET=

# AI Assistant configuration (OpenAI-compatible Chat Completions API)
# Leave AI_API_KEY empty to disable AI features in the UI.
# Examples for AI_BASE_URL:
#   OpenCode Go:  https://opencode.ai/zen/go/v1
#   Kilo Gateway: https://api.kilo.ai/api/openrouter
#   OpenAI:       https://api.openai.com/v1
#   Gemini:       https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter:   https://openrouter.ai/api/v1
AI_API_KEY=
AI_BASE_URL=https://opencode.ai/zen/go/v1
AI_MODEL=gpt-6-luna
AI_REASONING_EFFORT=max
AI_SESSION_ID=ses_learning_road_01
AI_TIMEOUT_MS=60000
